# ─────────────────────────────────────────────────────────────────────────────
# TradePro Backend — Environment Variables
# Copy this file to .env for local development. Never commit .env.
# On Render, set these directly in the "Environment" tab of your service.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5001

# Console log verbosity. "info" (default) suppresses per-tick/per-candle/per-message
# diagnostics and prints errors, warnings, auth/lifecycle events, and the 5-minute
# Module 1/2 health summaries. Set to "debug" locally to see tick-level detail again.
LOG_LEVEL=info

# Frontend origin for CORS — set to your Vercel deployment URL in production.
FRONTEND_URL=http://localhost:3000

# ── Authentication ────────────────────────────────────────────────────────────
# REQUIRED: Generate strong secrets before going to production.
# Run this command and paste the output below:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_64_BYTES_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STRONG_RANDOM_SECRET_64_BYTES_HEX

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/stock_dashboard
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/stock_dashboard?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/stock_dashboard

# ── Redis ─────────────────────────────────────────────────────────────────────
# Option 1 (recommended for Render): Upstash serverless Redis
UPSTASH_REDIS_REST_URL=https://<your-upstash-endpoint>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-upstash-token>

# Option 2: Standard ioredis (only used when Upstash vars are NOT set)
# REDIS_URL=redis://127.0.0.1:6379

# ── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@yourdomain.com

# ── Zebu Broker — Module 1 ───────────────────────────────────────────────────
ZEBU_USER_ID=your_zebu_user_id
ZEBU_API_KEY=your_zebu_api_key
ZEBU_VENDOR_CODE=your_vendor_code
ZEBU_TOTP_SECRET=your_totp_base32_secret

# NIFTY tokens (stable, rarely change)
ZEBU_NIFTY_FUT_TOKEN=26000
ZEBU_NIFTY_SPOT_TOKEN=26009

# NIFTY option tokens — AUTO-MANAGED by instrumentTokenService on each broker login.
# The app downloads https://go.mynt.in/NFO_symbols.txt and finds active weekly tokens.
# These .env values are used ONLY as fallback if the auto-download fails.
# Format: NFO|TOKEN:SYMBOL — comma-separated for multiple strikes.
ZEBU_NIFTY_CE_TOKENS=NFO|TOKEN1:NIFTY03JUL26C22000,...
ZEBU_NIFTY_PE_TOKENS=NFO|TOKEN1:NIFTY03JUL26P22000,...

# Reconnect/session-invalidity hardening (all optional — sensible defaults apply).
# How many consecutive `ck` (connect handshake) rejections of the SAME session
# token, with wording that isn't recognized as an explicit session-expiry
# message, before the token is treated as invalid anyway (stops automatic
# reconnect instead of reusing a dead token forever). Default 2.
MODULE1_SESSION_INVALID_REJECT_THRESHOLD=2
# Idle-WebSocket watchdog: if NOTHING (not even a Zebu heartbeat) arrives for
# this long, the socket is considered silently dead and is closed so the
# normal reconnect flow can recover it. Keep generous — a quiet options
# market must never trip this. Default 90000 (90s).
MODULE1_WS_IDLE_TIMEOUT_MS=90000
# How often the idle watchdog checks. Default 15000 (15s).
MODULE1_WS_IDLE_CHECK_INTERVAL_MS=15000

# ── Global market-data shutdown authorization ────────────────────────────────
# Comma-separated list of application usernames allowed to call
# POST /api/system/market-data/shutdown (stops Module 1 AND Module 2 for every
# connected user). Case-insensitive. FAILS CLOSED: leave unset and NO user —
# including otherwise-authenticated ones — can trigger a global shutdown.
MARKET_DATA_SHUTDOWN_ADMIN_USERNAMES=

# ── Aetram Broker — Module 2 ─────────────────────────────────────────────────
# Symphony FinTech MarketData API credentials (user-provided at login time via the UI)
MOD2_API_KEY=your_aetram_marketdata_app_key
MOD2_API_SECRET=your_aetram_marketdata_secret_key

# Symphony FinTech MarketData API endpoints
AETRAM_MARKETDATA_API_BASE_URL=https://developers.symphonyfintech.in/apibinarymarketdata
AETRAM_MARKETDATA_AUTH_URL=https://developers.symphonyfintech.in/apibinarymarketdata/auth/login

# Optional: comma-separated expiry dates (YYYY-MM-DD) used if the Aetram API
# does not expose an expiry list. Leave empty to auto-compute upcoming Thursdays.
# Example: MOD2_EXPIRY_DATES=2026-07-03,2026-07-10,2026-07-31
MOD2_EXPIRY_DATES=

# Optional: local Market Data session TTL in hours (default 8, matching the
# module JWT lifetime). The XTS login response carries no expiry, so the
# backend expires its own session after this window or on the first 401.
MOD2_SESSION_TTL_HOURS=8
